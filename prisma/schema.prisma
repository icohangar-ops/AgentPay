generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String
  category     String
  endpoint     String
  pricePerCall Float
  provider     String
  providerAddr String   @default("")
  status       String   @default("active")
  totalCalls   Int      @default(0)
  totalRevenue Float    @default(0)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  latency      Int      @default(0)
  uptime       Float    @default(99.9)
  tags         String   @default("[]")
  apiKey       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]
  reviews  Review[]
}

model Agent {
  id             String   @id @default(cuid())
  name           String
  role           String
  balance        Float    @default(0)
  publicKey      String   @default("")
  privateKey     String   @default("") // Encrypted Ed25519 private key (hex, testnet only)
  onChainBalance String   @default("") // Cached on-chain balance (CSPR string)
  status         String   @default("active")
  isOnChain      Boolean  @default(false) // Whether this agent uses real on-chain keys
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments Payment[]
  reviews  Review[]
}

model Payment {
  id              String   @id @default(cuid())
  agentId         String
  serviceId       String
  amount          Float
  status          String   @default("pending")
  txHash          String   @default("")
  requestId       String   @default("")
  responseData    String   @default("")
  latencyMs       Int      @default(0)
  onChain         Boolean  @default(false) // Whether this was a real on-chain payment
  deployHash      String   @default("") // Real deploy hash (different from mock txHash)
  deployStatus    String   @default("") // pending/confirmed/failed
  createdAt       DateTime @default(now())

  agent   Agent   @relation(fields: [agentId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  serviceId String
  agentId   String
  agentName String   @default("")
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  agent   Agent   @relation(fields: [agentId], references: [id])
}