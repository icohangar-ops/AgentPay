generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String
  category     String
  endpoint     String
  pricePerCall Float
  provider     String
  providerAddr String   @default("")
  status       String   @default("active")
  totalCalls   Int      @default(0)
  totalRevenue Float    @default(0)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  latency      Int      @default(0)
  uptime       Float    @default(99.9)
  tags         String   @default("[]")
  apiKey       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]
  reviews  Review[]
  treasuryDecisions TreasuryDecision[]
}

model Agent {
  id             String   @id @default(cuid())
  name           String
  role           String
  balance        Float    @default(0)
  publicKey      String   @default("")
  privateKey     String   @default("") // Encrypted Ed25519 private key (hex, testnet only)
  onChainBalance String   @default("") // Cached on-chain balance (CSPR string)
  status         String   @default("active")
  isOnChain      Boolean  @default(false) // Whether this agent uses real on-chain keys
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments Payment[]
  reviews  Review[]
  treasuryDecisions TreasuryDecision[]
}

model Payment {
  id              String   @id @default(cuid())
  agentId         String
  serviceId       String
  amount          Float
  status          String   @default("pending")
  txHash          String   @default("")
  requestId       String   @default("")
  responseData    String   @default("")
  latencyMs       Int      @default(0)
  onChain         Boolean  @default(false) // Whether this was a real on-chain payment
  deployHash      String   @default("") // Real deploy hash (different from mock txHash)
  deployStatus    String   @default("") // pending/confirmed/failed
  verified        Boolean  @default(false) // Whether deploy was verified on-chain before data delivery
  createdAt       DateTime @default(now())

  agent   Agent   @relation(fields: [agentId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  treasuryDecisions TreasuryDecision[]
}

model Review {
  id        String   @id @default(cuid())
  serviceId String
  agentId   String
  agentName String   @default("")
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  agent   Agent   @relation(fields: [agentId], references: [id])
}

// Allow Service to have TreasuryDecisions back-referenced (already added above)
// Allow Agent to have TreasuryDecisions back-referenced (already added above)

// ───────────────────────────────────────────────────────────────────
// Treasury Agent: LLM-driven autonomous decision engine
// Watches agent balances, decides when to call services on their behalf
// ───────────────────────────────────────────────────────────────────

model TreasuryConfig {
  id                  String   @id @default("singleton")
  enabled             Boolean  @default(true)
  // Auto-trigger interval in seconds (0 = manual only)
  intervalSeconds     Int      @default(300)
  // Minimum on-chain CSPR balance to keep on each agent (don't drain below this)
  minBalanceCSPR      Float    @default(0.5)
  // Maximum spend per decision cycle (CSPR)
  maxSpendPerCycleCSPR Float   @default(2.0)
  // Comma-separated list of allowed service categories; empty = all
  allowedCategories   String   @default("")
  // LLM model to use (glm-4.6, glm-4.5, etc.)
  llmModel            String   @default("glm-4.6")
  // Whether to actually execute calls or just log decisions (dry-run mode)
  dryRun              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TreasuryDecision {
  id           String   @id @default(cuid())
  agentId      String?   // The agent the decision is about
  // "call_service" | "no_action" | "skip_low_balance" | "skip_disabled"
  decision     String
  // Human-readable LLM reasoning
  reasoning    String
  // When decision=call_service, the chosen service
  serviceId    String?
  serviceName  String?
  // Amount in CSPR that was (or would be) spent
  amountCSPR   Float?
  // Payment ID if a payment was actually executed
  paymentId    String?
  // Deploy hash if an on-chain payment was executed
  deployHash   String?
  // "executed" | "dry_run" | "skipped"
  status       String
  // LLM model that produced this decision
  llmModel     String
  // Raw LLM response (JSON)
  llmResponse  String
  // Treasury cycle ID (multiple decisions share a cycle)
  cycleId      String
  createdAt    DateTime @default(now())

  agent    Agent?   @relation(fields: [agentId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])

  @@index([cycleId])
  @@index([agentId])
  @@index([createdAt])
}