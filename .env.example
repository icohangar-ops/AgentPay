# ── Contract Deployment (after funding) ──────────────────────────────
# Set these after deploying contracts to Casper Testnet via:
#   node scripts/deploy-contracts.mjs
#
# To fund the deployer key, visit https://testnet.cspr.live/faucet
# with the public key printed by the deploy script.

NEXT_PUBLIC_ESCROW_CONTRACT_HASH=
NEXT_PUBLIC_SERVICE_REGISTRY_CONTRACT_HASH=

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="file:./db/dev.db"